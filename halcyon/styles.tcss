Screen { background: $background; color: $foreground; layers: base overlay; }
Footer { height: 1; background: $surface; color: $halcyon-muted; }
#app-shell { height: 1fr; padding: 0 1; background: $background; }
#status-rail { height: 1; padding: 0 1; background: $surface; color: $halcyon-muted; }
#status, #audio-status { display: none; }
.panel-title { height: 1; color: $halcyon-muted; text-style: bold; content-align: left middle; }
#workspace-host, #main-workspace { height: 1fr; width: 100%; }
#main-workspace { layout: horizontal; }
.workspace-pane { background: $surface; border: tall $halcyon-line; }
#performance-stage { width: 1fr; min-width: 44; height: 100%; margin-right: 1; }
#scope-toolbar { height: 3; padding-left: 1; border-bottom: solid $halcyon-line; }
#scope-toolbar .panel-title { width: 1fr; }
#scope-toolbar Button { width: 9; min-width: 7; height: 3; border: none; background: transparent; color: $halcyon-muted; }
#scope-toolbar Button.selected, #compact-nav Button.selected { color: $halcyon-active; text-style: bold; background: $boost; }
#oscillator-scope { height: 1fr; min-height: 7; color: $halcyon-viz; background: $surface; }
#keyboard-title { height: 2; padding-left: 1; color: $halcyon-midi; border-top: solid $halcyon-line; }
#keyboard-legend { height: 1; padding-left: 1; color: $halcyon-muted; background: $surface; }
#keyboard-scroll { width: 100%; height: 12; background: $surface; overflow-x: auto; overflow-y: hidden; }
#keyboard { width: 527; height: 11; padding: 0; background: $surface; }
#activity-panel { width: 48; min-width: 31; height: 100%; padding: 0 1; }
#event-log { height: 1fr; width: 100%; background: $surface; border: none; }

SoundSettingsScreen { background: $background 58%; }
#settings-drawer { dock: right; width: 76; height: 100%; background: $panel; border-left: tall $halcyon-active; }
#settings-header { height: 6; padding: 1 2; border-bottom: solid $halcyon-line; }
#settings-heading { width: 1fr; height: 4; }
#settings-header #close-settings { width: 13; height: 3; border: none; }
#settings-scroll { height: 1fr; padding: 0 2 2 2; }
#synth-rack { height: auto; width: 100%; background: $panel; }
.settings-section-title { height: 3; margin-top: 1; color: $halcyon-active; text-style: bold; content-align: left middle; border-bottom: solid $halcyon-line; }
.settings-subtitle { height: 2; color: $halcyon-midi; text-style: bold; }
.settings-help { height: auto; min-height: 1; color: $halcyon-muted; }
#openai-credential-status { height: auto; min-height: 3; margin-top: 1; padding: 1; color: $halcyon-muted; background: $surface; border-left: thick $halcyon-line; }
#openai-credential-status.configured { color: $success; border-left: thick $success; }
#openai-credential-status.busy { color: $halcyon-target; border-left: thick $halcyon-target; }
#openai-credential-status.error { color: $error; border-left: thick $error; }
#openai-key-input { width: 1fr; height: 4; }
#openai-credential-actions { width: 100%; height: 4; margin-top: 1; }
#openai-credential-actions Button { width: 17; min-width: 14; height: 4; }
#openai-credential-feedback { height: 2; color: $success; }
#openai-credential-feedback.error { color: $error; }
#openai-credential-help { margin-bottom: 1; }
#preset-loaded-state { height: 3; padding: 1; color: $halcyon-midi; text-style: bold; }
#preset-help { height: 2; color: $halcyon-muted; }
#preset-list { height: auto; }
#preset-list Button { width: 100%; height: 3; border: none; background: $surface; color: $foreground; content-align: left middle; text-align: left; }
#preset-list Button.candidate { background: $boost; border-left: thick $halcyon-active; }
#preset-list Button.loaded { color: $halcyon-midi; text-style: bold; }
#preset-actions, .save-actions { height: 4; margin-top: 1; }
#preset-actions Button, .save-actions Button { width: 1fr; height: 4; min-width: 10; }
#preset-save-flow { height: auto; margin-top: 1; padding: 1; background: $surface; border: tall $halcyon-line; }
#preset-name-input { width: 100%; height: 4; }
#preset-feedback { height: 2; color: $success; }
#preset-feedback.error { color: $error; }
#knob-row { height: auto; }
SynthKnob { width: 100%; height: 8; padding: 1; color: $foreground; background: $surface; border-bottom: solid $halcyon-line; layout: horizontal; }
SynthKnob:focus { border: tall $halcyon-active; background: $boost; }
.knob-copy { width: 1fr; height: 5; }
.knob-label { height: 1; color: $foreground; text-style: bold; }
.knob-help { height: 2; color: $halcyon-muted; }
.knob-value { width: 12; height: 5; content-align: right middle; color: $halcyon-midi; }
.knob-adjust-row { height: 5; width: 28; }
.knob-step { width: 5; min-width: 5; height: 5; border: none; background: $boost; color: $foreground; }
.knob-meter { width: 1fr; height: 5; content-align: center middle; background: $panel; color: $halcyon-active; }

#command-console { height: 18; min-height: 13; margin-top: 1; padding: 0 1; }
#chat-panel { height: 1fr; background: $surface; }
#chat-log { height: 1fr; padding: 0 1; background: $surface; }
#chat-slash-hint { height: 1; padding: 0 1; color: $halcyon-target; background: $surface; }
#chat-input-row { height: 4; width: 100%; border-top: solid $halcyon-line; background: $background; }
#chat-prompt { width: 6; height: 4; content-align: center middle; color: $halcyon-midi; text-style: bold; }
#chat-input { width: 1fr; height: 4; border: none; background: $background; color: $foreground; }
#chat-input:focus { background: $panel; }
#chat-send { width: 9; min-width: 8; height: 4; border: none; background: $boost; color: $halcyon-active; }
#compact-nav { display: none; }

Screen.-medium #performance-stage { width: 1fr; }
Screen.-medium #activity-panel { width: 32; min-width: 28; }
Screen.-medium #command-console { height: 13; }
Screen.-medium #keyboard-scroll { height: 9; }
Screen.-medium #keyboard { height: 8; }
Screen.-medium #keyboard-legend { height: 1; }
SoundSettingsScreen.-medium #settings-drawer { width: 68; }

Screen.-compact Footer { display: none; }
Screen.-compact #app-shell { padding: 0; }
Screen.-compact #compact-nav { display: block; height: 3; layout: horizontal; background: $background; }
Screen.-compact #compact-nav Button { width: 1fr; height: 3; min-width: 10; border: none; background: $surface; color: $halcyon-muted; }
Screen.-compact #workspace-host, Screen.-compact #main-workspace { height: 1fr; }
Screen.-compact #main-workspace > .workspace-pane { display: none; }
Screen.-compact #command-console { display: none; }
Screen.-compact #app-shell.workspace-stage #performance-stage, Screen.-compact #app-shell.workspace-activity #activity-panel { display: block; width: 100%; min-width: 0; height: 100%; margin: 0; }
Screen.-compact #app-shell.workspace-console #main-workspace { display: none; }
Screen.-compact #app-shell.workspace-console #command-console { display: block; width: 100%; height: 100%; min-height: 0; margin: 0; }
Screen.-compact #keyboard-scroll { height: 8; }
Screen.-compact #keyboard { height: 7; }
Screen.-compact #keyboard-legend { height: 1; }
Screen.-compact #command-console .panel-title { display: none; }
Screen.-compact #chat-input-row, Screen.-compact #chat-input { height: 5; }
SoundSettingsScreen.-compact #settings-drawer { width: 100%; border-left: none; }
SoundSettingsScreen.-compact #settings-header { height: 5; padding: 0 1; }
SoundSettingsScreen.-compact #settings-heading .settings-help { display: none; }
SoundSettingsScreen.-compact #settings-scroll { padding: 0 1 1 1; }
SoundSettingsScreen.-compact #openai-credential-actions Button { width: 15; min-width: 12; }
SoundSettingsScreen.-compact SynthKnob { height: 10; layout: grid; grid-size: 2 2; grid-columns: 1fr 12; grid-rows: 4 5; }
SoundSettingsScreen.-compact .knob-adjust-row { width: 100%; column-span: 2; }
